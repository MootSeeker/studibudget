{
  "name": "studibudget",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "coverage:ratchet": "npm run test:coverage && node scripts/coverage-ratchet.mjs",
    "test:summary": "node scripts/test-summary.mjs",
    "test:watch": "vitest --project unit",
    "format": "prettier --write .",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run check:build",
    "test:db": "vitest run --project db",
    "check:build": "node scripts/check-build.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "check:vault": "node scripts/check-vault.mjs",
    "test:slow": "vitest run --project slow",
    "test:prop": "vitest run --project unit --tags-filter property",
    "test:mutation": "stryker run",
    "build:e2e": "vite build --outDir dist-e2e",
    "preview:e2e": "vite preview --outDir dist-e2e --port 4173 --strictPort",
    "test:e2e": "playwright test",
    "test:regression": "vitest run --project unit --tags-filter regression"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.3.3",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "5.0.3",
    "axe-core": "^4.13.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  },
  "license": "GPL-3.0-or-later",
  "overrides": {
    "glob": "^13.0.6",
    "qs": "^6.16.0"
  }
}
